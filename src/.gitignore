# .gitignore — .NET (Visual Studio) + Node/Next.js outputs and common temp files

#########################
# OS generated files
#########################
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

#########################
# Visual Studio
#########################
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.vcxproj.user

#########################
# Build output
#########################
**/bin/
**/obj/
**/publish/
artifacts/
TestResults/
*.log

#########################
# NuGet
#########################
*.nupkg
packages/
.nuget/

#########################
# Rider / JetBrains
#########################
.idea/
*.sln.iml

#########################
# VS Code
#########################
.vscode/

#########################
# Node / Frontend
#########################
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp.*
pnpm-debug.log*

# Next.js / build outputs
.next/
out/
build/
dist/
.vercel/

#########################
# TypeScript
#########################
*.tsbuildinfo

#########################
# Env / secrets / certificates
#########################
.env
.env.*.local
secrets.json
*.pfx
*.p12
*.cer
*.key
*.pem

#########################
# Test / coverage
#########################
coverage/
*.coverage
*.coveragexml
coverage.*

#########################
# Misc temporary files
#########################
logs/
temp/
tmp/
*.tmp
*.bak
*.cache

#########################
# Generated files
#########################
Generated/
**/Generated/

#########################
# Binaries
#########################
*.exe
*.dll
*.so
*.dylib
